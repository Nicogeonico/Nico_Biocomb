input_dir  = r"C:\Users\nicog\OneDrive\Desktop\cross_sections\for_conversion"
output_dir = r"C:\Users\nicog\OneDrive\Desktop\cross_sections\Final_Abs_data_for_graph"

# Cross-section → absorbance (Beer–Lambert: A = σ * N * L)
path_length_cm = 300           # cm
air_number_density = 2.5e19  # molecules/cm^3

# Cross-section files ppm (keys match filenames after removing "_final")
molecule_ppm = {
    "Ethanol": 1000,
    "Acetic_acid": 2,
    "Butyric_acid": 1,
    "Hexanoic_acid": 0.8,
    # Add more, e.g.: "Lactic_acid": 0.5,
}

# HITRAN settings
hapi_db_dir = r"C:\Users\nicog\OneDrive\Desktop\hapi_cache_fresh"
