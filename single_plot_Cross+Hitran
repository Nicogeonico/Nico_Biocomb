hitran_molecules = {
    "CO2":         {"hapi_name": "CO2",   "ID": 2,  "ppm": 500000, "alpha": 0.55},  # 50%
    "CH4":         {"hapi_name": "CH4",   "ID": 6,  "ppm": 50000,  "alpha": 0.55},  # 5%
    "H2O":         {"hapi_name": "H2O",   "ID": 1,  "ppm": 0.2,    "alpha": 0.55},  # very dry
    "Formic acid": {"hapi_name": "HCOOH", "ID": 28, "ppm": 0.05,   "alpha": 1.00},  # label pretty; HAPI=HCOOH
}

wavenumber_min = 833    # cm^-1
wavenumber_max = 3333   # cm^-1
resolution = 0.01       # cm^-1
pressure_atm = 1.0      # atm
