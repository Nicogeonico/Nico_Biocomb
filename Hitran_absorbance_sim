# ==============================
# Small utilities
# ==============================
def ensure_dir(path: str):
    os.makedirs(path, exist_ok=True)
    test = os.path.join(path, "_write_test.tmp")
    with open(test, "w") as f: f.write("ok")
    os.remove(test)

def start_hapi(dbdir: str):
    os.makedirs(dbdir, exist_ok=True)
    try:
        db_begin(dbdir)
    except Exception:
        shutil.rmtree(dbdir, ignore_errors=True)
        os.makedirs(dbdir, exist_ok=True)
        db_begin(dbdir)

def drop_if_exists(name: str):
    if name in tableList():
        try: dropTable(name)
        except Exception: pass

def fetch_lines(name: str, gas_id: int, iso: int, wn_min: float, wn_max: float):
    try:
        drop_if_exists(name)
        fetch(name, gas_id, iso, wn_min, wn_max)
    except Exception:
        drop_if_exists(name)
        fetch(name, gas_id, iso, wn_min, wn_max)

def file_key(path: str) -> str:
    stem = os.path.splitext(os.path.basename(path))[0].replace(" ", "_")
    return stem[:-6] if stem.endswith("_final") else stem

def fmt_ppm(x: float) -> str:
    return f"{int(x):,}" if x >= 1000 else f"{x:.3f}".rstrip("0").rstrip(".")

# ==============================
# Cross-section IO & conversion
# ==============================
def read_cross_section_csv(path: str) -> pd.DataFrame:
    """
    Accepts standard headers or 2-column (x,y) with x in cm^-1 / µm / nm.
    Returns columns: Wavenumber (cm⁻¹), CrossSection (cm²/molecule), Wavelength (µm/nm)
    """
    try:
        df = pd.read_csv(path)
    except Exception:
        df = pd.read_csv(path, header=None, comment="#", sep=None, engine="python")

    cols   = [str(c).strip() for c in df.columns.tolist()]
    lower  = [c.lower() for c in cols]

    # X axis → wavenumber cm^-1
    if any(("wavenumber" in c and ("cm" in c or "cm-1" in c or "1/cm" in c or "cm⁻¹" in c)) for c in lower):
        wn = df[cols[[i for i,c in enumerate(lower) if "wavenumber" in c][0]]].astype(float).to_numpy()
    else:
        x = df.iloc[:, 0].astype(float).to_numpy()
        xmax = float(np.nanmax(x))
        if   xmax > 1000: wn = x              # assume cm^-1
        elif xmax <   50: wn = 1e4 / x        # µm → cm^-1
        else:            wn = 1e7 / x         # nm → cm^-1

    # Y axis → cross section (assume column 2 if not labeled)
    if any(("cross" in c and ("section" in c or "sec" in c)) for c in lower):
        y = df[cols[[i for i,c in enumerate(lower) if ("cross" in c and ("section" in c or "sec" in c))][0]]].astype(float).to_numpy()
    else:
        y = df.iloc[:, 1].astype(float).to_numpy()

    y = np.clip(y, 0, None)  # trim tiny negatives

    out = pd.DataFrame({
        "Wavenumber (cm⁻¹)": wn,
        "CrossSection (cm²/molecule)": y
    })
    out = out.replace([np.inf, -np.inf], np.nan).dropna()
    out = out[out["Wavenumber (cm⁻¹)"] > 0].copy()
    out["Wavelength (µm)"] = 1e4 / out["Wavenumber (cm⁻¹)"]
    out["Wavelength (nm)"] = 1e7 / out["Wavenumber (cm⁻¹)"]
    return out

def convert_one_csv(path: str) -> tuple | None:
    key = file_key(path)
    if key not in MOLECULE_PPM:
        print(f"• skip {os.path.basename(path)} (no ppm for '{key}')")
        return None

    ppm = float(MOLECULE_PPM[key])
    X   = ppm * 1e-6
    Nmix = AIR_NUMBER_DENSITY * X

    df = read_cross_section_csv(path)
    # Beer–Lambert (Napierian), then → base-10
    A_e  = df["CrossSection (cm²/molecule)"].to_numpy(float) * Nmix * PATH_LENGTH_CM
    df["Absorbance"] = A_e / np.log(10.0)

    # Save converted table (same behavior as before)
    out_name = os.path.basename(path).replace(".csv", "_converted.xlsx")
    out_path = os.path.join(OUTPUT_DIR, out_name)
    try:
        df.to_excel(out_path, index=False, engine="openpyxl")
    except Exception as e:
        print(f"⚠ could not write {out_name}: {e}")

    # clip to plot window
    dfp = df[(df["Wavelength (µm)"] >= XLIM_UM[0]) & (df["Wavelength (µm)"] <= XLIM_UM[1])].copy()
    return (key.replace("_", " "), ppm, dfp)

def load_and_convert_all() -> list[tuple]:
    ensure_dir(OUTPUT_DIR)
    results = []

    # CSVs inside INPUT_DIR
    for name in os.listdir(INPUT_DIR):
        if name.lower().endswith(".csv"):
            r = convert_one_csv(os.path.join(INPUT_DIR, name))
            if r: results.append(r)

    # Explicit extra paths
    for p in EXTRA_FILES:
        r = convert_one_csv(p)
        if r: results.append(r)

    return results

# ==============================
# HITRAN simulation (base-10 absorbance)
# ==============================
def simulate_hitran() -> dict:
    start_hapi(HAPI_DB_DIR)
    nu_grid       = np.arange(WN_MIN, WN_MAX + 0.5 * RESOLUTION_CM1, RESOLUTION_CM1)
    wavelength_um = 1e4 / nu_grid
    traces = {}

    for label, info in HITRAN_MOLECULES.items():
        gas, gid, ppm = info["hapi_name"], info["ID"], float(info["ppm"])
        X = ppm * 1e-6

        fetch_lines(gas, gid, 1, WN_MIN, WN_MAX)
        env     = {"T": TEMPERATURE_K, "p": PRESSURE_ATM}
        diluent = {"air": max(0.0, 1.0 - X), gas: X}

        _, k_nu = absorptionCoefficient_Voigt(
            SourceTables=gas,
            OmegaGrid=nu_grid,
            Environment=env,
            Diluent=diluent,
            HITRAN_units=False
        )

        # store base-10 absorbance (A10) to match the rest of the script
        A10 = (k_nu * X * PATH_LEN_HITRAN_CM) / np.log(10.0)
        traces[label] = {
            "wavelength_um": wavelength_um,
            "absorbance": A10,
            "ppm": ppm,
            "alpha": info.get("alpha", 1.0),
        }
    return traces

# ==============================
# Plot
# ==============================
def plot_all(converted: list[tuple], traces: dict):
    # y-cap logic exactly like your original (preserve appearance)
    if YCLIP_ENABLED:
        y_cap = YCLIP_ABS
    else:
        pool = []
        for d in traces.values():
            pool.append(np.asarray(d["absorbance"], float))
        for _, _, dfp in converted:
            if not dfp.empty:
                pool.append(dfp["Absorbance"].to_numpy(float))
        nz = np.concatenate(pool)
        nz = nz[nz > 0]
        y_cap = float(np.quantile(nz, 0.99)) * 1.02 if nz.size else 1.0

    fig, ax = plt.subplots(figsize=(14, 6))

    def plot_with_cap(x, y, **kw):
        y = np.minimum(np.asarray(y, float), y_cap)
        ax.plot(x, y, **kw)

    # HITRAN backgrounds first
    for name in ["CO2", "CH4", "H2O"]:
        if name in traces:
            d = traces[name]
            plot_with_cap(
                d["wavelength_um"], d["absorbance"],
                label=f"{name} ({fmt_ppm(d['ppm'])} ppm)",
                linewidth=1.0, alpha=d.get("alpha", 0.6), zorder=1
            )

    # Other HITRAN (if any)
    for name, d in traces.items():
        if name in {"CO2", "CH4", "H2O"}: continue
        plot_with_cap(
            d["wavelength_um"], d["absorbance"],
            label=f"{name} ({fmt_ppm(d['ppm'])} ppm)",
            linewidth=1.2, alpha=d.get("alpha", 1.0), zorder=3
        )

    # Cross-section overlays
    print("\n🧪 Cross-section curves:")
    for mol, ppm, dfp in converted:
        if dfp.empty:
            print(f"• {mol}: no points in {XLIM_UM[0]}–{XLIM_UM[1]} µm")
            continue
        plot_with_cap(
            dfp["Wavelength (µm)"].values, dfp["Absorbance"].values,
            label=f"{mol} ({fmt_ppm(ppm)} ppm)", linewidth=1.4, zorder=4
        )
        print(f"• {mol}: plotted {len(dfp)} points")

    ax.set_title("Absorbance (base-10): HITRAN + Cross-section Molecules")
    ax.set_xlabel("Wavelength [µm]")
    ax.set_ylabel("Absorbance (−log10 T)")
    ax.set_xlim(*XLIM_UM)
    ax.set_ylim(0, y_cap)
    ax.grid(True, linestyle="--", linewidth=0.5)
    ax.legend(loc="upper right", fontsize=9)
    plt.tight_layout()
    plt.show()

# ==============================
# Main
# ==============================
if __name__ == "__main__":
    converted = load_and_convert_all()
    traces    = simulate_hitran()
    plot_all(converted, traces)
