import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import os
from hapi import *
from scipy.interpolate import interp1d

# === Initialize HITRAN database ===
db_begin("data")

# === Folder for cross-section absorbance files ===
folder_path = r"C:\Users\Nico\Desktop\cross_sections\Final_Abs_data_for_graph"
excluded_file = "Acetic acid.xlsx final"

# === HITRAN Molecules and Their Info (no scaling) ===
hitran_molecules = {
    "CO2": {"ID": 2, "ppm": 625000},  # test value
    "CH4": {"ID": 6, "ppm": 5000},  # 0.5%
    "HCOOH": {"ID": 28, "ppm": 125},  # trace
    "H2O": {"ID": 1, "ppm": 20000},  # ~2% water vapor
}

# === Simulation parameters ===
wavenumber_min = 833  # cm^-1
wavenumber_max = 3333  # cm^-1
resolution = 0.01  # cm^-1
temperature = 296  # K
pressure = 1.0  # atm
path_length_m = 3  # meters
path_length = path_length_m

nu_master = np.arange(wavenumber_min, wavenumber_max, resolution)
wavelength_master = 1e4 / nu_master  # µm

# === Figure ===
fig, (ax_hitran, ax_cs) = plt.subplots(
    2, 1, figsize=(14, 10), sharex=True, gridspec_kw={"height_ratios": [2, 1]}
)
fig.subplots_adjust(hspace=0.28)

# ===============================
# Top panel: HITRAN simulations
# ===============================
print("\n📡 HITRAN-based simulations (linear scale, no N2/O2):")
for gas, info in hitran_molecules.items():
    gas_id = info["ID"]
    ppm = info["ppm"]
    mole_fraction = ppm * 1e-6
    isotopologue = 1

    print(f"→ {gas}: {ppm} ppm")
    fetch(gas, gas_id, isotopologue, wavenumber_min, wavenumber_max)

    nu, k_nu = absorptionCoefficient_Voigt(
        SourceTables=gas,
        OmegaStep=resolution,
        OmegaRange=(wavenumber_min, wavenumber_max),
        HITRAN_units=False,
    )

    interp_k = interp1d(nu, k_nu, kind="linear", bounds_error=False, fill_value=0.0)
    k_master = interp_k(nu_master)
    absorbance = k_master * (mole_fraction * pressure) * path_length

    # Set transparency for CO2 and H2O
    alpha_val = 0.6 if gas in ["H2O", "CO2"] else 1.0

    ax_hitran.plot(
        wavelength_master,
        absorbance,
        label=f"{gas} ({ppm:,} ppm)",
        linewidth=1.0,
        alpha=alpha_val,
    )

ax_hitran.set_title("HITRAN Molecules — Absorbance (Linear Scale)")
ax_hitran.set_ylabel("Absorbance (unitless)")
ax_hitran.set_xlim(3, 12)
ax_hitran.set_ylim(0, 0.1)  # clip to show smaller features
ax_hitran.grid(True, linestyle="--", linewidth=0.5)
ax_hitran.legend(loc="upper right", fontsize=9)

# ==================================
# Bottom panel: Cross-section files
# ==================================
print("\n🧪 Cross-section (non-HITRAN) files (linear scale):")
for filename in os.listdir(folder_path):
    if not (filename.endswith(".xlsx") or filename.endswith(".csv")):
        continue

    if filename.strip().lower() == excluded_file.strip().lower():
        print(f"🚫 Skipping excluded file: {filename}")
        continue

    file_path = os.path.join(folder_path, filename)
    df = (
        pd.read_excel(file_path, engine="openpyxl")
        if filename.endswith(".xlsx")
        else pd.read_csv(file_path)
    )

    if "Wavelength (µm)" not in df.columns or "Absorbance" not in df.columns:
        print(f"⚠️ Skipping {filename}: required columns not found")
        continue

    molecule_name = (
        os.path.splitext(filename)[0].replace("_converted", "").replace("_", " ")
    )

    df = df[(df["Wavelength (µm)"] >= 3.0) & (df["Wavelength (µm)"] <= 12.0)]

    ax_cs.plot(
        df["Wavelength (µm)"].values,
        df["Absorbance"].values,
        label=f"{molecule_name}",
        linewidth=1.0,
    )
    print(f"→ {molecule_name}: plotted {len(df)} points")

ax_cs.set_title("Cross-section Molecules — Absorbance (Linear Scale)")
ax_cs.set_xlabel("Wavelength [µm]")
ax_cs.set_ylabel("Absorbance (unitless)")
ax_cs.set_xlim(3, 12)
ax_cs.grid(True, linestyle="--", linewidth=0.5)
ax_cs.legend(loc="upper right", fontsize=9)

plt.tight_layout()
plt.show()

